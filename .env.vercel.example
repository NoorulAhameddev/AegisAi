# Vercel Environment Variables for Aegis AI

# Required for database connection
DATABASE_URL=
# Required for Redis queue (BullMQ)
REDIS_URL=
# OpenRouter API key for LLM access
OPENROUTER_API_KEY=
# 32-char encryption key for AES-256-GCM
ENCRYPTION_KEY=
# (Optional) Custom Next.js base path
# BASE_PATH=
# (Optional) Other secrets as needed
