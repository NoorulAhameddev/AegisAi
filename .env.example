# PostgreSQL Database Connection
# ============================================================================
# CRITICAL CONFIGURATION - MUST BE SET IN PRODUCTION
# ============================================================================

# Database Configuration
# Format: postgresql://username:password@host:port/database_name?connection_limit=20&pool_timeout=10
# Connection pool parameters:
#   - connection_limit: Max connections (recommended: 10-20 for most apps, scale based on load)
#   - pool_timeout: Connection acquisition timeout in seconds (recommended: 10)
# Production example:
# DATABASE_URL=postgresql://postgres:password@postgres.example.com:5432/aegis_ai?connection_limit=20&pool_timeout=10&sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/aegis_ai

# Application Environment
APP_ENV=development

# Redis Connection for BullMQ job queue and rate limiting
REDIS_URL=redis://localhost:6379

# JWT Secrets (minimum 32 characters each for security)
# Generate using: openssl rand -base64 32
# DO NOT use the default values in production
JWT_ACCESS_SECRET=your_min_32_character_access_secret_here_2024_replace_me
JWT_REFRESH_SECRET=your_min_32_character_refresh_secret_here_2024_replace_me

# Secrets Provider (required)
SECRET_PROVIDER=aws-kms
ENCRYPTION_KEY_CIPHERTEXT=your_kms_encrypted_key_ciphertext_here
AWS_REGION=us-east-1

# Encryption Key (32 character hex string for AES-256-GCM)
# Generate using: openssl rand -hex 16
# Used for encrypting sensitive user data and file storage
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# AI Model Configuration
# OpenRouter provides unified access to multiple AI models
# Get API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
OPENROUTER_SITE_URL=https://yourdomain.com
OPENROUTER_SITE_NAME=Aegis AI

# Application Configuration
NODE_ENV=production
SITE_URL=https://yourdomain.com
SITE_NAME=Aegis AI

# ============================================================================
# OPTIONAL CONFIGURATION
# ============================================================================

# Chat and LLM Settings
MAX_TOKENS=2000
CHAT_HISTORY_LIMIT=10
LLM_MODEL=openai/gpt-4o-mini

# File Upload Settings
MAX_FILE_SIZE=52428800  # 50MB in bytes
UPLOAD_DIR=./uploads

# RAG Configuration
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=5
RAG_RERANK_ENABLED=true

# Vector Database Configuration (Phase 2 Enhancement)
# Choose between 'lancedb' (local/embedded, default) or 'pgvector' (PostgreSQL, production)
VECTOR_DB_PROVIDER=lancedb

# pgvector Configuration (only needed if VECTOR_DB_PROVIDER=pgvector)
# Uses same DATABASE_URL by default, or specify separate connection if needed
# PGVECTOR_HOST=localhost
# PGVECTOR_PORT=5432
# PGVECTOR_DB=aegis_vectors

# Multi-Modal Embedding Configuration (Phase 2 Enhancement)
# Embedding model: 'text-embedding-3-small' (1536 dims, default) or 'text-embedding-3-large' (3072 dims)
EMBEDDING_MODEL=text-embedding-3-small

# Hugging Face API for CLIP image embeddings (Phase 2 Enhancement)
# Get from: https://huggingface.co/settings/tokens
# HUGGINGFACE_API_KEY=hf_your_api_key_here

# Cross-Encoder Reranking Model (Phase 3 Enhancement)
# Default: ms-marco-MiniLM-L-12-v2
CROSS_ENCODER_MODEL=ms-marco-MiniLM-L-12-v2

# Semantic Caching Configuration (Phase 4 Enhancement)
# Cache TTL in seconds (86400 = 24 hours)
SEMANTIC_CACHE_TTL=86400

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# Admin Configuration
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change_me_in_production

# Security Headers
NEXT_PUBLIC_CSP_HEADER="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline';"

# Video/Audio Processing
# Optional: Configure external services if needed
YOUTUBE_API_KEY=optional_youtube_api_key

# Email Configuration (optional, for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# External Services (optional)
# Add any additional external service configurations here

# Feature Flags
ENABLE_RAG=true
ENABLE_ENCRYPTION=true
ENABLE_FILE_UPLOAD=true
ENABLE_YOUTUBE_INGESTION=true
ENABLE_WEB_SCRAPING=true
ENABLE_AUDIO_TRANSCRIPTION=true
ENABLE_IMAGE_OCR=true
ENABLE_BATCH_PROCESSING=true

# CRITICAL SECURITY: Serverless function execution disabled by default
# vm2 dependency has critical vulnerability (CVE-2023-37466)
# Only enable after migrating to isolated-vm or AWS Lambda
ENABLE_SERVERLESS_FUNCTIONS=false

# ============================================================================
# MONITORING & ERROR TRACKING
# ============================================================================

# Sentry Configuration (Production Monitoring)
# Get DSN from: https://sentry.io/settings/[your-org]/projects/[your-project]/keys/
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project-id
# SENTRY_RELEASE=1.0.0  # Auto-populated in CI/CD
# SENTRY_AUTH_TOKEN=your_auth_token_here  # For source maps upload in CI/CD
