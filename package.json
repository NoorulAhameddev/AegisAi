{
  "name": "aegis-ai-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "test": "jest",
    "dev": "npm run dev --workspace=apps/web",
    "dev:mobile": "npm run start --workspace=apps/mobile",
    "build": "npm run build --workspace=apps/web",
    "build:all": "npm run build --workspaces --if-present",
    "start": "npm run start --workspace=apps/web",
    "worker": "tsx apps/web/src/workers/chat.worker.ts",
    "worker:rag": "tsx apps/web/src/workers/rag.worker.ts",
    "worker:websocket": "tsx apps/web/src/workers/websocket.worker.ts",
    "worker:video-summary": "tsx apps/web/src/workers/video-summary.worker.ts",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "clean": "node -e \"const fs=require('fs'); const rm=p=>fs.rmSync(p,{recursive:true,force:true}); ['apps/web/.next','out','dist','build','coverage','logs','data/lancedb','.turbo'].forEach(rm); if(fs.existsSync('uploads')){for(const f of fs.readdirSync('uploads')){if(f!=='.gitkeep')rm('uploads/'+f);}}\"",
    "test": "npm run test --workspaces --if-present",
    "test:watch": "npm run test:watch --workspace=apps/web",
    "test:coverage": "npm run test:coverage --workspace=apps/web",
    "test:mcp": "tsx infra/scripts/test-mcp.ts",
    "test:edge": "tsx infra/scripts/test-edge.ts",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:dry-run": "prisma migrate deploy --dry-run",
    "studio": "prisma studio",
    "cleanup:sessions": "tsx infra/scripts/cleanup-sessions.ts",
    "docker:build": "cd infra/docker && docker build -t aegis-ai .",
    "docker:up": "cd infra/docker && docker-compose up -d",
    "docker:down": "cd infra/docker && docker-compose down",
    "mcp:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\start-mcp.ps1",
    "setup": "scripts\\setup-local.ps1",
    "prepare": "node -e \"try { require('husky').install() } catch (e) {}\""
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1156.0",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@azure/storage-blob": "^12.34.0",
    "@google-cloud/storage": "^8.4.0",
    "@lancedb/lancedb": "^0.40.0",
    "@langchain/community": "1.1.29",
    "@langchain/core": "1.3.0",
    "@langchain/openai": "^1.7.0",
    "@modelcontextprotocol/server-filesystem": "^2026.1.14",
    "@modelcontextprotocol/server-github": "^2025.4.8",
    "@modelcontextprotocol/server-puppeteer": "^2025.5.12",
    "@prisma/client": "^7.10.1",
    "@types/jsonwebtoken": "^9.0.10",
    "apache-arrow": "21.2.0",
    "archiver": "^8.0.0",
    "aws-embedded-metrics": "^4.2.0",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.4.2",
    "cheerio": "^1.1.2",
    "clsx": "^2.1.1",
    "docx": "^9.14.0",
    "duck-duck-scrape": "^2.2.7",
    "force": "^0.0.3",
    "googlethis": "^1.8.0",
    "ioredis": "^6.0.0",
    "isomorphic-dompurify": "^4.6.0",
    "jsonwebtoken": "^9.0.3",
    "katex": "^0.19.1",
    "langchain": "^1.5.19",
    "lucide-react": "^1.61.0",
    "mammoth": "^1.13.0",
    "marked": "^18.1.1",
    "multer": "^2.5.0",
    "n8n-mcp": "^2.99.0",
    "next": "^16.4.3",
    "openai": "7.43.0",
    "opossum": "^10.0.0",
    "p-retry": "^8.0.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2",
    "prisma": "^7.10.1",
    "puppeteer": "^25.16.0",
    "react": "^19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "stripe": "^23.0.1",
    "tailwind-merge": "^3.7.0",
    "tesseract.js": "^7.0.0",
    "youtube-transcript": "^1.3.1",
    "zod": "4.6.7"
  },
  "overrides": {
    "apache-arrow": "21.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/archiver": "^8.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26",
    "@types/opossum": "^8.1.9",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "baseline-browser-mapping": "^2.11.32",
    "cross-fetch": "^4.0.0",
    "dotenv": "18.0.9",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,json,css,md}": [
      "prettier --write"
    ]
  }
}
