{
  "name": "aegis-ai",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p 3000",
    "worker": "tsx src/workers/ai.worker.ts",
    "lint": "eslint",
    "clean": "node -e \"const fs=require('fs'); const rm=p=>fs.rmSync(p,{recursive:true,force:true}); ['.next','out','dist','build','coverage','logs','data/lancedb','.turbo'].forEach(rm); if(fs.existsSync('uploads')){for(const f of fs.readdirSync('uploads')){if(f!=='.gitkeep')rm('uploads/'+f);}}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:mcp": "tsx scripts/test-mcp.ts",
    "test:edge": "tsx scripts/test-edge.ts",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "studio": "prisma studio",
    "cleanup:sessions": "tsx scripts/cleanup-sessions.ts",
    "docker:build": "docker build -t aegis-ai .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
