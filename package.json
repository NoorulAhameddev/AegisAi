{
  "name": "aegis-ai-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "dev": "npm run dev --workspace=apps/web",
    "dev:mobile": "npm run start --workspace=apps/mobile",
    "build": "npm run build --workspace=apps/web",
    "build:all": "npm run build --workspaces --if-present",
    "start": "npm run start --workspace=apps/web",
    "worker": "tsx apps/web/src/workers/chat.worker.ts",
    "worker:rag": "tsx apps/web/src/workers/rag.worker.ts",
    "worker:websocket": "tsx apps/web/src/workers/websocket.worker.ts",
    "worker:video-summary": "tsx apps/web/src/workers/video-summary.worker.ts",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "clean": "node -e \"const fs=require('fs'); const rm=p=>fs.rmSync(p,{recursive:true,force:true}); ['apps/web/.next','out','dist','build','coverage','logs','data/lancedb','.turbo'].forEach(rm); if(fs.existsSync('uploads')){for(const f of fs.readdirSync('uploads')){if(f!=='.gitkeep')rm('uploads/'+f);}}\"",
    "test:watch": "npm run test:watch --workspace=apps/web",
    "test:coverage": "jest --coverage --config=config/jest.config.ts",
    "test:mcp": "tsx infra/scripts/test-mcp.ts",
    "test:edge": "tsx infra/scripts/test-edge.ts",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:dry-run": "prisma migrate deploy --dry-run",
    "studio": "prisma studio",
    "cleanup:sessions": "tsx infra/scripts/cleanup-sessions.ts",
    "docker:build": "cd infra/docker && docker build -t aegis-ai .",
    "docker:up": "cd infra/docker && docker-compose up -d",
    "docker:down": "cd infra/docker && docker-compose down",
    "mcp:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\start-mcp.ps1",
    "setup": "scripts\\setup-local.ps1",
    "prepare": "husky install"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.983.0",
    "@aws-sdk/client-s3": "^3.983.0",
    "@aws-sdk/s3-request-presigner": "^3.983.0",
    "@azure/storage-blob": "^12.15.0",
    "@google-cloud/storage": "^7.19.0",
    "@lancedb/lancedb": "^0.23.0",
    "@langchain/core": "0.3.80",
    "@langchain/openai": "^0.3.17",
    "@modelcontextprotocol/server-filesystem": "^2026.1.14",
    "@modelcontextprotocol/server-github": "^2025.4.8",
    "@modelcontextprotocol/server-puppeteer": "^2025.5.12",
    "@prisma/client": "^5.17.0",
    "@types/jsonwebtoken": "^9.0.10",
    "apache-arrow": "18.1.0",
    "archiver": "^7.0.1",
    "aws-embedded-metrics": "^4.2.0",
    "axios": "^1.7.2",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.66.4",
    "cheerio": "^1.1.2",
    "clsx": "^2.1.1",
    "docx": "^9.0.0",
    "duck-duck-scrape": "^2.2.7",
    "ioredis": "^5.8.2",
    "isomorphic-dompurify": "^3.0.0",
    "jsonwebtoken": "^9.0.3",
    "katex": "^0.19.0",
    "langchain": "^0.3.37",
    "lucide-react": "^0.562.0",
    "mammoth": "^1.8.0",
    "marked": "^15.0.4",
    "multer": "^2.0.2",
    "n8n-mcp": "^2.33.5",
    "next": "^16.4.2",
    "openai": "4.62.1",
    "opossum": "^8.1.4",
    "p-retry": "^6.2.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.15.0",
    "prisma": "^5.17.0",
    "puppeteer": "^25.14.0",
    "react": "^19.2.0",
    "react-dom": "19.2.9",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.8.3",
    "stripe": "^14.0.0",
    "tailwind-merge": "^3.4.0",
    "tesseract.js": "^7.0.0",
    "youtube-transcript": "^1.2.1",
    "zod": "3.23.8"
  },
  "overrides": {
    "basic-ftp": "^6.2.1",
    "katex": "^0.19.0",
    "@modelcontextprotocol/server-puppeteer": {
      "puppeteer": "^25.14.0"
    },
    "apache-arrow": "18.1.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "decode-uri-component": "^0.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/archiver": "^6.0.2",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^29.5.11",
    "@types/multer": "^2.0.0",
    "@types/node": "^20",
    "@types/opossum": "^8.1.9",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfkit": "^0.13.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "baseline-browser-mapping": "^2.9.19",
    "cross-fetch": "^4.0.0",
    "dotenv": "16.4.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "husky": "^8.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^14.0.0",
    "prettier": "^3.0.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,json,css,md}": [
      "prettier --write"
    ]
  }
}
