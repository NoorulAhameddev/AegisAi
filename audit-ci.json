  "vulnerabilityManagementPolicy": {
    "version": "1.0.0",
    "lastReviewed": "2026-11-07",
    "reviewCycle": "Quarterly or upon major dependency upgrades",
    "description": "Explicit vulnerability exemption policy documenting unpatched upstream CVEs in accordance with Milestone M3 and Section 3 of SPECIFICATION_FINAL_APPROVAL_READY.md. Silencing via || true is prohibited.",
    "documentedUpstreamVulnerabilities": [
      {
        "package": "@langchain/core",
        "advisories": [
          "GHSA-r399-636x-v7f6"
        ],
        "severity": "high",
        "rationale": "Transitive upstream dependency of the LangChain ecosystem. Aegis AI does not accept untrusted serialized objects or invoke unsafe deserialization endpoints. Monorepo upgrade to LangChain 1.x is isolated from remediation campaign to prevent breaking AI prompt and streaming contracts."
      },
      {
        "package": "ws",
        "advisories": [
          "GHSA-96hv-2xvq-fx4p",
          "GHSA-58qx-3vcg-4xpx"
        ],
        "severity": "high",
        "rationale": "Transitive dependency in Socket.io adapter and React Native dev middleware. Upstream fix requires breaking protocol and dependency upgrades. Mitigated at perimeter via WebSocket worker ping/pong intervals, request timeout controls, and body size limits."
      },
      {
        "package": "websocket-driver",
        "advisories": [
          "GHSA-mp7j-qc5w-4988",
          "GHSA-xv26-6w52-cph6"
        ],
        "severity": "critical",
        "rationale": "Deep transitive dependency through legacy test/scraping utilities. No non-breaking patch exists in the 0.2.x series. The component is not exposed to external WebSocket traffic in production runtime."
      },
      {
        "package": "zod",
        "advisories": [
          "GHSA-mrhx-c7xc-m3w5"
        ],
        "severity": "high",
        "rationale": "Direct dependency pinned at 3.23.8. Fix requires Zod 4.x which is a major breaking rewrite across all request/response models. Mitigated by Next.js request body size limits and pre-parsing length validations."
      },
      {
        "package": "bullmq",
        "advisories": [
          "GHSA-6prh-2h8m-c8cw"
        ],
        "severity": "high",
        "rationale": "Internal job queue engine. Redis containers are bound strictly to 127.0.0.1; workers do not expose queue interfaces directly to external HTTP ingress."
      },
      {
        "package": "@modelcontextprotocol/sdk",
        "advisories": [
          "GHSA-345p-7cg4-v4c7",
          "GHSA-w48q-cv73-mx4w",
          "GHSA-8r9q-7v3j-jr4g",
          "GHSA-6qxp-vccf-f47h",
          "GHSA-22jm-h49p-29qw",
          "GHSA-46jr-4wx8-v453",
          "GHSA-rvq5-wwqv-78pq",
          "GHSA-f897-62hf-6gxq"
        ],
        "severity": "high",
        "rationale": "Used solely for client-side transport and internal developer tooling behind strict authentication. MCP servers run within sandboxed local processes."
      },
      {
        "package": "@hono/node-server",
        "advisories": [
          "GHSA-wc8c-qw6v-h7f6",
          "GHSA-92pp-h63x-v22m",
          "GHSA-frvp-7c67-39w9"
        ],
        "severity": "high",
        "rationale": "Development-only server adapter; production static asset serving is handled natively by Next.js and CDN."
      },
      {
        "package": "axios",
        "advisories": [
          "GHSA-wf5p-g6vw-rhxx",
          "GHSA-jr5f-v2jv-69x6",
          "GHSA-3p68-rc4w-qgx5",
          "GHSA-w9j2-pvgh-6h63",
          "GHSA-pmwg-cvhr-8vh7",
