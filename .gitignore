################################################################################
# PRODUCTION-READY GITIGNORE
# Aegis AI - Next.js 16 + TypeScript Enterprise Chat Platform (Monorepo)
# 
# Files needed to run the project ARE committed:
#   - Source code (src/, apps/)
#   - Configuration (*.config.js, tsconfig.json)
#   - Package files (package.json, package-lock.json)
#   - Documentation (*.md, docs/)
#   - Database schema (prisma/schema.prisma)
#   - Public assets (public/)
#   - Tests (__tests__/, *.test.ts, tests/)
#   - Mobile app (apps/mobile/)
#   - Git config (.github/, .gitignore)
#   - Environment template (.env.example)
#
# Everything else (node_modules, build output, secrets) is ignored
################################################################################

################################################################################
# DEPENDENCIES & PACKAGE MANAGERS
################################################################################
node_modules/
.pnp
.pnp.js
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
package-lock.json.backup
npm-shrinkwrap.json

################################################################################
# BUILD OUTPUT & ARTIFACTS
################################################################################
# Next.js
.next/
out/
build/
dist/
.next/cache
.vercel/

# TypeScript
*.tsbuildinfo
next-env.d.ts
tsconfig.tsbuildinfo

# Build caches
.swc/
.turbo/
.eslintcache
.parcel-cache/

################################################################################
# RUNTIME DATA & DATABASES
################################################################################
# Local data stores
data/lancedb/
apps/web/data/lancedb/
apps/admin/data/

# Database files
*.db
*.sqlite
*.sqlite3
prisma/dev.db
prisma/dev.db-journal

# Redis dump files
dump.rdb
appendonly.aof

# File uploads (keep directory structure only)
uploads/*
!uploads/.gitkeep
apps/web/uploads/*
!apps/web/uploads/.gitkeep

################################################################################
# ENVIRONMENT & SECRETS (CRITICAL)
################################################################################
# All environment files except template
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
.env.staging.local
.env.production
.env.staging
.env.development
.envrc
.direnv/

# Mobile-specific environment files
mobile/.env.production
mobile/.env.staging
mobile/.env.development

################################################################################
# LOGS & DEBUG OUTPUT
################################################################################
# Node logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# Application logs
*.log
logs/
.logs/
*.log.*
server_debug.log

################################################################################
# IDE & EDITOR
################################################################################
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/launch.json.example

.idea/
*.sublime-project
*.sublime-workspace
.DS_Store

################################################################################
# OPERATING SYSTEM
################################################################################
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

################################################################################
# PYTHON & VIRTUAL ENVIRONMENTS
################################################################################
.venv/
venv/
ENV/
env/
.Python
*.py[cod]
*$py.class
*.so
__pycache__/
*.egg-info/
dist/
build/

################################################################################
# JUPYTER NOTEBOOKS
################################################################################
.ipynb_checkpoints
*.ipynb

################################################################################
# TEMPORARY & BACKUP FILES
################################################################################
*.tmp
*.bak
*.backup
*_old
*_backup
*.orig
*.swp
*.swo
*~
*.pem

################################################################################
# TESTING & COVERAGE
################################################################################
/coverage
.nyc_output/
*.lcov

################################################################################
# DEVELOPMENT TOOLS & TEMPORARY FOLDERS
################################################################################
# Playwright & MCP testing
.playwright-mcp/
# Note: .agent/ is tracked in .git/info/exclude for local-only exclusion
# This allows AI IDEs (Cursor, Windsurf, VS Code) to index workflows properly

# Deployment & verification
.vercel
.netlify

################################################################################
# PROJECT-SPECIFIC IGNORES
################################################################################
# Mobile Expo
mobile/.expo/
mobile/.expo-shared/
apps/mobile/.expo/
apps/mobile/.expo-shared/
apps/mobile/ios/
apps/mobile/android/

# Redis tools
tools/redis/
tools/*.zip
tools/*.tar.gz

# Monorepo specific
apps/*/node_modules/
services/*/node_modules/
packages/*/node_modules/
apps/*/.next/
apps/*/dist/
apps/*/build/

# Docker volumes and data
infra/docker/data/
infra/docker/volumes/
infra/docker/.env

# Keep root config & sources, ignore node_modules in subdirectories

################################################################################
# CERTIFICATES & KEYS
################################################################################
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
*.jks
*.keystore
*.mobileprovision

################################################################################
# AWS & CLOUD CREDENTIALS
################################################################################
.aws/
.azure/
aws-exports.js
amplify/
.amplify-hosting/

################################################################################
# SENTRY & ERROR TRACKING
################################################################################
.sentryclirc
sentry.properties

################################################################################
# CACHE DIRECTORIES
################################################################################
.cache/
.npm/
.eslintcache
.stylelintcache
mobile/node_modules/

################################################################################
# FILE PATTERNS TO ALWAYS IGNORE
################################################################################
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
