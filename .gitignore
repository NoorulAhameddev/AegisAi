################################################################################
# PRODUCTION-READY GITIGNORE
# Aegis AI - Next.js 16 + TypeScript Enterprise Chat Platform
# 
# Files needed to run the project ARE committed:
#   - Source code (src/)
#   - Configuration (*.config.js, tsconfig.json)
#   - Package files (package.json, package-lock.json)
#   - Documentation (*.md, docs/)
#   - Database schema (prisma/schema.prisma)
#   - Public assets (public/)
#   - Tests (__tests__/, *.test.ts)
#   - Mobile app (mobile/)
#   - Git config (.github/, .gitignore)
#   - Environment template (.env.example)
#
# Everything else (node_modules, build output, secrets) is ignored
################################################################################

################################################################################
# DEPENDENCIES & PACKAGE MANAGERS
################################################################################
node_modules/
.pnp
.pnp.js
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

################################################################################
# BUILD OUTPUT & ARTIFACTS
################################################################################
# Next.js
.next/
out/
build/
dist/
.next/cache

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Build caches
.swc/
.turbo/
.eslintcache

################################################################################
# RUNTIME DATA & DATABASES
################################################################################
# Local data stores
data/lancedb/

# Database files
*.db
*.sqlite
*.sqlite3
prisma/dev.db
prisma/dev.db-journal

# File uploads (keep directory structure only)
uploads/*
!uploads/.gitkeep

################################################################################
# ENVIRONMENT & SECRETS (CRITICAL)
################################################################################
# All environment files except template
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
.env.staging.local
.env.production
.env.staging
.env.development
.envrc
.direnv/

# Mobile-specific environment files
mobile/.env.production
mobile/.env.staging
mobile/.env.development

################################################################################
# LOGS & DEBUG OUTPUT
################################################################################
# Node logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# Application logs
*.log
logs/
.logs/
*.log.*
server_debug.log

################################################################################
# IDE & EDITOR
################################################################################
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/launch.json.example

.idea/
*.sublime-project
*.sublime-workspace
.DS_Store

################################################################################
# OPERATING SYSTEM
################################################################################
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

################################################################################
# PYTHON & VIRTUAL ENVIRONMENTS
################################################################################
.venv/
venv/
ENV/
env/
.Python
*.py[cod]
*$py.class
*.so
__pycache__/
*.egg-info/
dist/
build/

################################################################################
# JUPYTER NOTEBOOKS
################################################################################
.ipynb_checkpoints
*.ipynb

################################################################################
# TEMPORARY & BACKUP FILES
################################################################################
*.tmp
*.bak
*.backup
*_old
*_backup
*.orig
*.swp
*.swo
*~
*.pem

################################################################################
# TESTING & COVERAGE
################################################################################
/coverage
.nyc_output/
*.lcov

################################################################################
# DEVELOPMENT TOOLS & TEMPORARY FOLDERS
################################################################################
# Playwright & MCP testing
.playwright-mcp/
.agent/

# Deployment & verification
.vercel
.netlify

################################################################################
# PROJECT-SPECIFIC IGNORES
################################################################################
# Mobile Expo
mobile/.expo/
mobile/.expo-shared/

# Redis tools
tools/redis/
tools/*.zip
tools/*.tar.gz

# Keep root config & sources, ignore node_modules in subdirectories
mobile/node_modules/

################################################################################
# FILE PATTERNS TO ALWAYS IGNORE
################################################################################
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
