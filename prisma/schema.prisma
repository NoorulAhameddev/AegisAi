generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AuditLog {
  id            String   @id @default(uuid())
  userId        String?
  adminRole     String?  @db.VarChar(50)
  action        String   @db.VarChar(255)
  targetType    String?  @db.VarChar(100)
  targetId      String?
  previousState Json?
  newState      Json?
  metadata      Json?
  reason        String?  @db.Text
  ticketId      String?  @db.VarChar(100)
  ipAddress     String?  @db.VarChar(45)
  userAgent     String?  @db.VarChar(500)
  mfaVerified   Boolean  @default(false)
  integrityHash String?  @db.VarChar(64)
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model Project {
  id          String   @id @default(uuid())
  userId      String
  name        String   @db.VarChar(255)
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  User        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  Chat        Chat[]
  File        File[]
  Note        Note[]

  @@index([userId, createdAt])
}

model Chat {
  id        String    @id @default(uuid())
  userId    String
  projectId String?
  title     String?   @db.VarChar(255)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  User      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  Project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  Message   Message[]

  @@index([userId, createdAt])
  @@index([projectId])
}

model File {
  id          String   @id @default(uuid())
  userId      String
  projectId   String?
  name        String   @db.VarChar(255)
  type        String   @db.VarChar(100)
  content     String   @db.Text
  path        String   @default("")
  encryptedPath String? @db.VarChar(500)
  size        Int      @default(0)
  metadata    Json?
  tags        String[] @default([])
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  Project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([projectId])
  @@index([tags])
}

model Memory {
  id        String     @id @default(uuid())
  userId    String
  type      MemoryType
  content   String     @db.Text
  source    String?
  createdAt DateTime   @default(now())
  User      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([userId, createdAt])
}

model Message {
  id        String      @id @default(uuid())
  chatId    String
  role      MessageRole
  content   String      @db.Text
  createdAt DateTime    @default(now())
  Chat      Chat        @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
  @@index([chatId, role])
}

model Session {
  id         String   @id @default(uuid())
  userId     String
  token      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastActive DateTime @default(now())
  userAgent  String?  @db.VarChar(500)
  ipAddress  String?  @db.VarChar(45)
  User       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model SystemSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model UsageMetric {
  id        String   @id @default(uuid())
  userId    String
  tokens    Int
  model     String?  @db.VarChar(50)
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Note {
  id        String     @id @default(uuid())
  userId    String
  projectId String?
  type      NoteType
  title     String     @db.VarChar(500)
  content   String     @db.Text
  sourceId  String?
  version   Int        @default(1)
  tags      String[]   @default([])
  metadata  Json?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, type])
  @@index([projectId])
  @@index([tags])
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  password     String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  role         Role          @default(USER)
  isBanned     Boolean       @default(false)
  tokenVersion Int           @default(0)
  Chat         Chat[]
  Memory       Memory[]
  Session      Session[]
  UsageMetric  UsageMetric[]
  Project      Project[]
  Note         Note[]

  @@index([email])
}

enum NoteType {
  SUMMARY_SHORT
  SUMMARY_DETAILED
  STRUCTURED_NOTES
  BULLET_POINTS
  KEY_CONCEPTS
  GLOSSARY
  EXAMPLES
  ELI5
  FLASHCARDS
  QUIZ
  QUESTIONS
  EXAM_NOTES
}

enum MemoryType {
  USER_FACT
  SUMMARY
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
  MODERATOR
  ANALYST
  SUPPORT
}
