generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // NOTE: VS Code Prisma extension shows deprecation warning for Prisma 7+
  // We are on Prisma 5.17.0 where this syntax is valid and correct
  // Migration to Prisma 7 config pattern planned for Q2 2026
  url      = env("DATABASE_URL")
}

model AuditLog {
  id            String   @id @default(uuid())
  userId        String?
  adminRole     String?  @db.VarChar(50)
  action        String   @db.VarChar(255)
  targetType    String?  @db.VarChar(100)
  targetId      String?
  previousState Json?
  newState      Json?
  metadata      Json?
  reason        String?  @db.Text
  ticketId      String?  @db.VarChar(100)
  ipAddress     String?  @db.VarChar(45)
  userAgent     String?  @db.VarChar(500)
  mfaVerified   Boolean  @default(false)
  integrityHash String?  @db.VarChar(64)
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model Project {
  id          String   @id @default(uuid())
  userId      String
  name        String   @db.VarChar(255)
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  User        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  Chat        Chat[]
  File        File[]
  Note        Note[]

  @@index([userId, createdAt])
}

model Chat {
  id        String    @id @default(uuid())
  userId    String    // Chat owner
  projectId String?
  title     String?   @db.VarChar(255)
  
  // Character/Persona field
  characterId String? // Selected AI character preset for this chat
  
  // Collaboration fields
  isShared  Boolean   @default(false)  // Whether chat is shared with others
  shareToken String?  @unique @db.VarChar(255) // Public share link token (optional)
  
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?  // Soft delete timestamp for GDPR compliance
  
  User      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  Project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  Character CharacterPreset? @relation(fields: [characterId], references: [id], onDelete: SetNull)
  Message   Message[]
  ConversationSummary ConversationSummary[]
  UserPresence UserPresence[]
  ChatPermission ChatPermission[]  // Who has access and their roles
  ChatActivity   ChatActivity[]    // Activity log for shared chats
  ChatInvitation ChatInvitation[]  // Pending invitations

  @@index([userId, createdAt])
  @@index([projectId])
  @@index([characterId])
  @@index([deletedAt]) // Index soft delete for fast filtering
  @@index([isShared])
  @@index([shareToken])
}

model CharacterPreset {
  id            String   @id @default(uuid())
  userId        String?  // NULL = system preset (admin-created), non-NULL = user-created
  name          String   @db.VarChar(255)
  description   String?  @db.Text
  avatar        String?  @db.VarChar(500) // Emoji or image URL
  systemPrompt  String   @db.Text
  temperature   Float    @default(0.7)
  model         String   @db.VarChar(100) @default("openai/gpt-4o-mini")
  maxTokens     Int?     // Optional token limit override
  
  // Visibility & permissions
  isPublic      Boolean  @default(false) // Available to all users
  isSystem      Boolean  @default(false) // Admin-created, cannot be deleted by users
  isActive      Boolean  @default(true)  // Soft delete
  
  // Metadata
  tags          String[] @default([])
  category      String?  @db.VarChar(100) // "Education", "Coding", "Creative", etc.
  usageCount    Int      @default(0) // Popularity tracking
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Relations
  User User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  Chat Chat[]
  
  @@index([userId, isActive])
  @@index([isPublic, isActive])
  @@index([isSystem, isActive])
  @@index([category])
  @@index([tags])
  @@index([usageCount])
}

model File {
  id          String   @id @default(uuid())
  userId      String
  projectId   String?
  name        String   @db.VarChar(255)
  type        String   @db.VarChar(100)
  content     String   @db.Text
  path        String   @default("")
  encryptedPath String? @db.VarChar(500)
  size        Int      @default(0)
  metadata    Json?
  tags        String[] @default([])
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime? // Soft delete timestamp for GDPR compliance
  Project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  User        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions    FileVersion[]
  @@index([userId, createdAt])
  @@index([projectId])
  @@index([tags])
  @@index([deletedAt]) // Index soft delete for fast filtering
  @@unique([userId, name], name: "File_userId_name_key") // Prevent duplicate file uploads
}

model FileVersion {
  id              String   @id @default(uuid())
  fileId          String
  versionNumber   Int
  fileName        String   @db.VarChar(255)
  mimeType        String   @db.VarChar(100)
  size            Int
  hash            String   @db.VarChar(64)
  filePath        String   @db.Text
  createdBy       String
  createdAt       DateTime @default(now())
  changeLog       String?  @db.Text
  isCurrentVersion Boolean  @default(false)
  File            File     @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([fileId, versionNumber])
  @@index([createdAt])
  @@unique([fileId, versionNumber])
}

model Memory {
  id        String     @id @default(uuid())
  userId    String
  type      MemoryType
  content   String     @db.Text
  source    String?
  createdAt DateTime   @default(now())
  User      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([userId, createdAt])
}

model Message {
  id        String      @id @default(uuid())
  chatId    String
  role      MessageRole
  content   String      @db.Text
  contentHash String?   @db.VarChar(64)
  isPartial Boolean     @default(false) // True if stream was interrupted before completion
  flagged   Boolean     @default(false) // True if moderation detected policy violations
  createdAt DateTime    @default(now())
  deletedAt DateTime?   // Soft delete timestamp for GDPR compliance
  Chat      Chat        @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
  @@index([chatId, role])
  @@index([chatId, role, contentHash])
  @@index([chatId, deletedAt, createdAt]) // Composite for chat history pagination
  @@index([deletedAt]) // Index soft delete for fast filtering
  @@index([flagged])   // Index for admin moderation review
}

model ConversationSummary {
  id              String   @id @default(uuid())
  chatId          String   @unique
  summaryIndex    Int      @default(1) // Which compression cycle (1st = messages 1-30, 2nd = 31-60, etc)
  startMessageId  String
  endMessageId    String
  startTimestamp  DateTime
  endTimestamp    DateTime
  summary         String   @db.Text // The actual summary text
  messageCount    Int      // How many messages were summarized
  tokensSaved     Int      // Estimated tokens saved by compression
  createdAt       DateTime @default(now())
  Chat            Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@unique([chatId, summaryIndex])
  @@index([chatId])
  @@index([createdAt])
}

model Session {
  id         String   @id @default(uuid())
  userId     String
  token      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastActive DateTime @default(now())
  userAgent  String?  @db.VarChar(500)
  ipAddress  String?  @db.VarChar(45)
  User       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model UserPresence {
  id        String   @id @default(uuid())
  userId    String
  chatId    String
  status    String   @db.VarChar(20) @default("online") // online, away, offline, typing
  lastSeen  DateTime @default(now())
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  Chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@unique([userId, chatId])
  @@index([chatId, status])
  @@index([userId, status])
  @@index([lastSeen])
}

model CacheEntry {
  id         String   @id @default(uuid())
  cacheKey   String   @unique
  resourceId String
  userId     String
  createdAt  DateTime @default(now())
  purgedAt   DateTime?

  @@index([userId, createdAt])
  @@index([resourceId])
}

model ServerlessFunction {
  id                  String   @id @default(uuid())
  userId              String
  name                String   @db.VarChar(255)
  description         String?  @db.Text
  code                String   @db.Text
  runtime             String   @db.VarChar(50)
  environmentVariables String? @db.Text
  timeout             Int      @default(30000) // milliseconds
  memory              Int      @default(128) // MB
  status              String   @db.VarChar(50) @default("draft") // draft, active, disabled
  executions          FunctionExecution[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status])
}

model FunctionExecution {
  id           String   @id @default(uuid())
  functionId   String
  function     ServerlessFunction @relation(fields: [functionId], references: [id], onDelete: Cascade)
  status       String   @db.VarChar(50)
  input        Json?
  output       Json?
  error        String?  @db.Text
  duration     Int      @default(0) // milliseconds
  memoryUsed   Int      @default(0) // MB
  executedAt   DateTime @default(now())

  @@index([functionId])
  @@index([executedAt])
  @@index([status])
}

model EdgeFunction {
  id                   String   @id @default(uuid())
  userId               String
  name                 String   @db.VarChar(255)
  slug                 String   @db.VarChar(100)
  code                 String   @db.Text
  regions              String[] @default(["global"])
  environmentVariables String?  @db.Text
  routes               String[] @default(["/api/function"])
  cacheControl         String?  @db.VarChar(255)
  status               String   @db.VarChar(50) @default("draft") // draft, deployed, archived
  deployments          EdgeDeployment[]
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userId])
  @@unique([userId, slug])
}

model EdgeDeployment {
  id         String   @id @default(uuid())
  functionId String
  function   EdgeFunction @relation(fields: [functionId], references: [id], onDelete: Cascade)
  region     String   @db.VarChar(50)
  version    Int      @default(1)
  url        String   @db.VarChar(500)
  status     String   @db.VarChar(50) // deploying, deployed, failed
  deployedAt DateTime @default(now())

  @@index([functionId])
  @@index([region])
  @@unique([functionId, region])
}

model SystemSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model UsageMetric {
  id        String   @id @default(uuid())
  userId    String
  tokens    Int
  model     String?  @db.VarChar(50)
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model TokenUsageCounter {
  userId        String   @id
  hourStart     DateTime
  dayStart      DateTime
  monthStart    DateTime
  hourlyTokens  Int      @default(0)
  dailyTokens   Int      @default(0)
  monthlyTokens Int      @default(0)
  updatedAt     DateTime @updatedAt

  User User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Note {
  id        String     @id @default(uuid())
  userId    String
  projectId String?
  type      NoteType
  title     String     @db.VarChar(500)
  content   String     @db.Text
  sourceId  String?
  version   Int        @default(1)
  tags      String[]   @default([])
  metadata  Json?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, type])
  @@index([projectId])
  @@index([tags])
}

model GeneratedImage {
  id           String   @id @default(uuid())
  userId       String
  prompt       String   @db.Text
  revisedPrompt String?  @db.Text
  imageUrl     String   @db.Text
  generatedAt  DateTime @default(now())
  deletedAt    DateTime?
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, generatedAt])
  @@index([deletedAt])
}

model ImageFile {
  id         String   @id @default(uuid())
  userId     String
  fileId     String   @unique
  fileName   String   @db.VarChar(255)
  mimeType   String   @db.VarChar(100)
  size       Int
  hash       String   @db.VarChar(64)
  filePath   String   @db.Text
  metadata   Json?
  uploadedAt DateTime @default(now())
  deletedAt  DateTime?
  User       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, uploadedAt])
  @@index([hash])
  @@index([deletedAt])
}

model Document {
  id              String   @id @default(uuid())
  text            String   @db.Text
  // pgvector embeddings (production-ready vector storage)
  vector          Unsupported("vector(1536)")?  // Primary vector (text-embedding-3-small)
  textEmbedding   Unsupported("vector(3072)")?  // For text-embedding-3-large
  imageEmbedding  Unsupported("vector(1536)")?  // For image embeddings (CLIP)
  metadata        Json?
  contentHash     String?  @db.VarChar(64)
  imageData       String?  @db.Text       // Base64 encoded image
  imageMimeType   String?                 // e.g., "image/jpeg", "image/png"
  userId          String
  sourceId        String?
  chunkIndex      Int?
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([userId, sourceId])
  @@index([createdAt])
  @@unique([userId, sourceId, chunkIndex])
}

model User {
  id                  String        @id @default(uuid())
  name                String
  email               String        @unique
  password            String
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  role                Role          @default(USER)
  isBanned            Boolean       @default(false)
  tokenVersion        Int           @default(0)
  
  // OAuth provider fields
  provider            String?       @db.VarChar(50) // google, github, etc.
  providerId          String?       @db.VarChar(255) // OAuth provider user ID
  picture             String?       @db.VarChar(500) // Profile picture URL
  
  // Monetization fields
  plan                PricingTier   @default(FREE)
  stripeCustomerId    String?       @unique @db.VarChar(255) // Stripe customer ID for payment processing
  subscriptionEndsAt  DateTime?     // When current subscription expires (null = never)
  monthlyTokenLimit   Int?          // Override default token limit (null = use tier default)
  
  // Relations
  Chat                 Chat[]
  Memory              Memory[]
  Session             Session[]
  UsageMetric         UsageMetric[]
  TokenUsageCounter   TokenUsageCounter?
  Project             Project[]
  File                File[]
  Note                Note[]
  UserPresence        UserPresence[]
  GeneratedImage      GeneratedImage[]
  ImageFile           ImageFile[]
  Subscription        Subscription[] // History of subscription changes
  Payment             Payment[]      // Payment history
  CharacterPreset     CharacterPreset[] // User-created character presets

  @@index([email])
  @@index([plan])
  @@index([subscriptionEndsAt])
  @@index([provider, providerId])
}

enum NoteType {
  SUMMARY_SHORT
  SUMMARY_DETAILED
  STRUCTURED_NOTES
  BULLET_POINTS
  KEY_CONCEPTS
  GLOSSARY
  EXAMPLES
  ELI5
  FLASHCARDS
  QUIZ
  QUESTIONS
  EXAM_NOTES
}

enum MemoryType {
  USER_FACT
  SUMMARY
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum PricingTier {
  FREE      // Free tier
  PRO       // Pro tier ($9.99/month)
  ENTERPRISE // Enterprise tier (custom pricing)
}

enum ChatRole {
  VIEWER    // Can only view messages
  COMMENTER // Can view and add comments
  EDITOR    // Can add messages and edit
  ADMIN     // Full control (can manage permissions)
  OWNER     // Chat creator (highest privilege)
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
  MODERATOR
  ANALYST
  SUPPORT
}

model FeatureFlag {
  id                String   @id @default(uuid())
  name              String   @unique
  enabled           Boolean  @default(false)
  description       String?  @db.Text
  rolloutPercentage Int?     // 0-100: percentage of users who get the feature
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([name])
  @@index([enabled])
}
// Monetization: Subscription tracking
model Subscription {
  id                String   @id @default(uuid())
  userId            String
  plan              PricingTier
  startDate         DateTime @default(now())
  endDate           DateTime? // Null for active subscriptions
  stripeSessionId   String?  @db.VarChar(255) // Stripe checkout session ID
  stripePriceId     String?  @db.VarChar(255) // Stripe price ID
  status            String   @db.VarChar(50) // active, cancelled, past_due
  autoRenew         Boolean  @default(true)
  createdAt         DateTime @default(now())
  cancelledAt       DateTime?
  cancelReason      String?  @db.Text
  
  User User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([plan])
  @@index([startDate, endDate])
}

// Monetization: Payment history
model Payment {
  id                String   @id @default(uuid())
  userId            String
  amount            Float    // Amount in cents (e.g., 999 = $9.99)
  currency          String   @db.VarChar(3) @default("USD")
  status            String   @db.VarChar(50) // succeeded, failed, pending
  stripePaymentId   String?  @unique @db.VarChar(255) // Stripe payment intent ID
  invoiceId         String?  @db.VarChar(255) // Invoice reference
  description       String?  @db.Text
  metadata          Json?    // Additional metadata (subscription ID, etc)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  User User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status])
  @@index([createdAt])
}

// Real-time Collaboration: Chat permissions and access control
model ChatPermission {
  id        String   @id @default(uuid())
  chatId    String
  userId    String
  role      ChatRole @default(VIEWER)
  invitedBy String?  // User ID who invited this person
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  Chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  
  @@unique([chatId, userId]) // One role per user per chat
  @@index([chatId])
  @@index([userId])
  @@index([role])
}

// Real-time Collaboration: Activity tracking for shared chats
model ChatActivity {
  id        String   @id @default(uuid())
  chatId    String
  userId    String
  action    String   @db.VarChar(100) // joined, left, edited, deleted_message, etc.
  metadata  Json?    // Additional context (message ID, old value, etc.)
  createdAt DateTime @default(now())
  
  Chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  
  @@index([chatId, createdAt])
  @@index([userId])
}

// Real-time Collaboration: Pending chat invitations
model ChatInvitation {
  id         String   @id @default(uuid())
  chatId     String
  inviterId  String  // User who sent invitation
  inviteeEmail String @db.VarChar(255) // Email of invited person
  status     String   @db.VarChar(50) @default("pending") // pending, accepted, declined
  message    String?  @db.Text // Optional invitation message
  expiresAt  DateTime // Expiration timestamp
  createdAt  DateTime @default(now())
  acceptedAt DateTime?
  
  Chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  
  @@unique([chatId, inviteeEmail]) // One pending invite per email per chat
  @@index([chatId])
  @@index([inviteeEmail, status])
  @@index([status])
}
// PostgreSQL Fallback Queue for Redis outages
model FallbackQueue {
  id           String    @id
  queueName    String    @map("queue_name") @db.VarChar(100)
  data         Json
  attempts     Int       @default(0)
  maxAttempts  Int       @map("max_attempts") @default(3)
  status       String    @db.VarChar(50) @default("pending") // pending, processing, completed, failed
  error        String?   @db.Text
  createdAt    DateTime  @map("created_at") @default(now())
  processedAt  DateTime? @map("processed_at")
  
  @@index([queueName, status, createdAt])
  @@index([status])
  @@map("fallback_queue")
}
