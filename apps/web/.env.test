# Test Environment Variables
APP_ENV=test
NODE_ENV=test
PORT=3000

# Database
DATABASE_URL=postgresql://test:test@localhost:5432/aegis_test

# JWT Secrets (32+ characters)
JWT_ACCESS_SECRET=test-access-secret-key-minimum-32-characters-long-for-security
JWT_REFRESH_SECRET=test-refresh-secret-key-minimum-32-characters-long-for-security

# Encryption (32 characters exactly)
ENCRYPTION_KEY=test-encryption-key-32-chars!!

# Redis
REDIS_URL=redis://localhost:6379

# OpenRouter
OPENROUTER_API_KEY=sk-or-test-key-for-testing-purposes-only

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Optional Services (for tests that need them)
GOOGLE_CLIENT_ID=test-client-id
GOOGLE_CLIENT_SECRET=test-client-secret
GITHUB_CLIENT_ID=test-github-id
GITHUB_CLIENT_SECRET=test-github-secret

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE=52428800
UPLOAD_DIR=uploads/test
