# Aegis AI - Example Environment Variables
# Copy this file to .env or .env.local and fill in real values for production or local use

# --- Core Secrets (REQUIRED) ---
# IMPORTANT: Replace these placeholders with secure, rotated secrets when provisioning environments.
JWT_ACCESS_SECRET=REMOVE_ME_GENERATE_STRONG_SECRET
JWT_REFRESH_SECRET=REMOVE_ME_GENERATE_STRONG_SECRET
ENCRYPTION_KEY=REMOVE_ME_GENERATE_HEX_KEY
OPENROUTER_API_KEY=REMOVE_ME_ADD_API_KEY

# --- Database ---
DB_USER=postgres
DB_PASSWORD=REMOVE_ME_GENERATE_DB_PASSWORD
DB_NAME=aegis_ai
DB_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/aegis_ai

# --- Redis ---
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_URL=redis://:your_redis_password@redis:6379

# --- App ---
APP_PORT=3000
SITE_URL=http://localhost:3000
SITE_NAME=Aegis AI

# --- Admin/pgAdmin (optional) ---
PGADMIN_EMAIL=admin@aegis.local
PGADMIN_PASSWORD=REMOVE_ME_GENERATE_STRONG_PASSWORD
PGADMIN_PORT=5050

# --- Sentry (optional) ---
SENTRY_DSN=REMOVE_ME_ADD_SENTRY_DSN

# --- AWS KMS (optional, for prod encryption) ---
SECRET_PROVIDER=aws-kms
ENCRYPTION_KEY_CIPHERTEXT=REMOVE_ME_ADD_KMS_CIPHERTEXT
AWS_REGION=us-east-1

# --- Other (add as needed) ---
# MCP_SERVERS=...
# CUSTOM_ENV=...
